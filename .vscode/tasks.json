{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "compile_platform",
            "type": "shell",
            "command": "odin",
            "args": [
                "build",
                "src/platform",
                "-out:bin/run.exe",
                "-debug",
                "-subsystem:windows",
            ],
            "group": "build",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "close": false
            }
        },
        {
            "label": "compile_game",
            "type": "shell",
            "command": "odin",
            "args": [
                "build",
                "src/game",
                "-build-mode:dll",
                "-out:bin/game.dll",
                "-debug",
            ],
            "group": "build",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "close": false
            }
        },
        {
            "label": "compile_tests",
            "type": "shell",
            "command": "odin",
            "args": [
                "build",
                "src/test",
                "-out:bin/test.exe",
                "-build-mode:test",
                "-debug",
            ],
            "group": "build",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "close": false
            }
        },
        {
            "label": "hot_reload",
            "type": "shell",
            "command": "odin",
            "args": [
                "run",
                "src/build",
                "-out:bin/hot.exe"
            ],
            "group": "build",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "close": false
            }
        },
        {
            "label": "build",
            "dependsOn": ["compile_platform", "compile_game", "compile_tests"],
            "dependsOrder": "parallel"
        }
    ]
}